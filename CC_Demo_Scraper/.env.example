# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
#
# This project is deliberately source-agnostic in code: every value that would
# reveal which external catalog it points at, or what table it writes into,
# lives here instead of in committed source. Fill these in privately.

# Local Docker postgres (see ../docker-compose.yml)
PGHOST=localhost
PGPORT=5434
PGDATABASE=cc_demo_db
PGUSER=cc_demo_admin
PGPASSWORD=cc_password_local

# External catalog API this scraper crawls.
SOURCE_NAME=source
SOURCE_BASE_URL=https://example.invalid/api
# Optional: an account with the source may raise its hourly rate limit above the anonymous tier.
SOURCE_USERNAME=
SOURCE_PASSWORD=
# Seconds to sleep between requests. Lower = faster but more likely to hit 429s.
SOURCE_REQUEST_DELAY_SECONDS=5.0
# Numeric id used to filter the series catalog down to the publisher we care about.
SOURCE_PUBLISHER_ID=0
# Table this scraper writes raw rows into.
SOURCE_TABLE_NAME=Raw_Source_Data
